        {
            "key": "field_home_hero_background_type",
            "label": "Hero Background Type",
            "name": "hero_background_type",
            "type": "select",
            "instructions": "Choose whether the hero section behind the title uses a still image or an autoplaying looped video.",
            "choices": {
                "image": "Image",
                "video": "Video"
            },
            "default_value": "image",
            "ui": 1,
            "return_format": "value",
            "wrapper": { "width": "50" }
        },
        {
            "key": "field_home_hero_background_image",
            "label": "Hero Background Image",
            "name": "hero_background_image",
            "type": "image",
            "return_format": "array",
            "preview_size": "medium",
            "instructions": "Used as the background when Background Type is Image. Also shown as the poster frame while the video loads/if Background Type is Video.",
            "wrapper": { "width": "50" }
        },
        {
            "key": "field_home_hero_background_video",
            "label": "Hero Background Video",
            "name": "hero_background_video",
            "type": "file",
            "return_format": "url",
            "library": "all",
            "mime_types": "mp4,webm,mov",
            "instructions": "MP4 recommended (H.264). Plays muted, autoplay, on loop, with no controls. Keep it short (10–20s) and under ~8MB so it loads fast — it's re-downloaded by every visitor.",
            "conditional_logic": [
                [
                    {
                        "field": "field_home_hero_background_type",
                        "operator": "==",
                        "value": "video"
                    }
                ]
            ],
            "wrapper": { "width": "50" }
        },
        {
            "key": "field_home_hero_background_opacity",
