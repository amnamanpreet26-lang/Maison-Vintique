{
    "key": "group_mv_wine_details",
    "title": "Wine Details",
    "fields": [
        {
            "key": "field_mv_tab_technical",
            "label": "General",
            "name": "",
            "type": "tab",
            "placement": "top"
        },
        {
            "key": "field_mv_producer",
            "label": "Producer",
            "name": "producer",
            "type": "post_object",
            "instructions": "The estate that makes this wine.",
            "post_type": [
                "producer"
            ],
            "return_format": "object",
            "ui": 1,
            "allow_null": 1,
            "multiple": 0
        },
        {
            "key": "field_mv_awards",
            "label": "Awards",
            "name": "awards",
            "type": "textarea",
            "rows": 4,
            "instructions": "ONE AWARD PER LINE, for example: Gold - IWC 2023 (new line) 92 pts - Decanter. Fill this in and the wine card gets the round \"Award Winning\" medallion over the bottle on hover, and the product page lists every line in full. Leave it empty and neither appears - an empty field is the usual reason the medallion does not show."
        },
        {
            "key": "field_mv_label_artwork",
            "label": "Label Artwork",
            "name": "label_artwork",
            "type": "file",
            "instructions": "The bottle label artwork - a JPG, PNG or PDF. Upload one and it appears on the product page in the \"Awards & Label\" block, in the same list as the awards, with a label icon. Leave it empty and only the awards show.",
            "return_format": "array",
            "library": "all",
            "mime_types": "jpg,jpeg,png,pdf,svg"
        },
        {
            "key": "field_mv_vintage_year",
            "label": "Vintage",
            "name": "vintage_year",
            "type": "text",
            "instructions": "e.g. 2019",
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_mv_abv",
            "label": "Alcohol (ABV %)",
            "name": "abv",
            "type": "number",
            "append": "%",
            "min": 0,
            "max": 25,
            "step": 0.1,
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_mv_min_order_qty",
            "label": "Minimum Order Quantity (cases)",
            "name": "min_order_qty",
            "type": "number",
            "instructions": "Enforced at checkout. Leave blank or 1 for no minimum.",
            "default_value": 1,
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_mv_bottle_size",
            "label": "Bottle Size",
            "name": "bottle_size",
            "type": "text",
            "default_value": "75cl",
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_mv_allergens",
            "label": "Allergens",
            "name": "allergens",
            "type": "text",
            "default_value": "Contains sulphites"
        },
        {
            "key": "field_mv_case_format",
            "label": "Case Format",
            "name": "case_format",
            "type": "text",
            "default_value": "6 x 75cl"
        },
        {
            "key": "field_mv_tab_tasting",
            "label": "Tasting & Story",
            "name": "",
            "type": "tab",
            "placement": "top"
        },
        {
            "key": "field_mv_tasting_notes",
            "label": "Tasting Notes",
            "name": "tasting_notes",
            "type": "wysiwyg",
            "tabs": "visual",
            "toolbar": "basic",
            "media_upload": 0
        },
        {
            "key": "field_mv_tab_terroir",
            "label": "Technical Info",
            "name": "",
            "type": "tab",
            "placement": "top"
        },
        {
            "key": "field_mv_case_appellation",
            "label": "Appellation",
            "name": "appellation",
            "type": "text",
            "default_value": "Bordeaux Supérieur AOC"
        },
        {
            "key": "field_mv_bottles_per_case",
            "label": "Bottles per Case",
            "name": "bottles_per_case",
            "type": "number",
            "default_value": 6,
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_mv_case_closure",
            "label": "Closure",
            "name": "closure",
            "type": "text",
            "default_value": "Natural cork"
        },
        {
            "key": "field_mv_ageing",
            "label": "Ageing",
            "name": "ageing",
            "type": "text",
            "instructions": "How it was aged, in words - for example \"12 months in French oak, 30% new\".",
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_mv_drinking_window",
            "label": "Drinking Window",
            "name": "drinking_window",
            "type": "text",
            "instructions": "When it drinks best - for example \"2025-2032\".",
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_mv_box_orientation",
            "label": "Box Orientation",
            "name": "box_orientation",
            "type": "text",
            "instructions": "How the case should be stored or shipped - for example \"Lying down\" or \"Upright\".",
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_mv_residual_sugar",
            "label": "Residual Sugar",
            "name": "residual_sugar",
            "type": "text",
            "instructions": "Include the unit, for example \"2.4 g/l\".",
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_mv_total_acidity",
            "label": "Total Acidity",
            "name": "total_acidity",
            "type": "text",
            "instructions": "Include the unit, for example \"5.6 g/l\".",
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_mv_ph_level",
            "label": "pH",
            "name": "ph_level",
            "type": "text",
            "instructions": "For example \"3.45\".",
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_mv_organic",
            "label": "Organic",
            "name": "organic",
            "type": "true_false",
            "instructions": "Switch on and the Technical tab shows \"Organic: Yes\". Off and the row is hidden.",
            "ui": 1,
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_mv_sustainability",
            "label": "Sustainability",
            "name": "sustainability",
            "type": "textarea",
            "rows": 2
        },
        {
            "key": "field_mv_case_serving",
            "label": "Serving",
            "name": "serving",
            "type": "text",
            "default_value": "16–18°C, decant 1hr"
        },
        {
            "key": "field_mv_tab_downloads",
            "label": "Downloads",
            "name": "",
            "type": "tab",
            "placement": "top"
        },
        {
            "key": "field_mv_technical_sheet",
            "label": "Technical Sheet (PDF)",
            "name": "technical_sheet",
            "type": "file",
            "return_format": "url",
            "library": "all",
            "wrapper": {
                "width": "50"
            }
        }
    ],
    "location": [
        [
            {
                "param": "post_type",
                "operator": "==",
                "value": "product"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "hide_on_screen": "",
    "active": true,
    "description": "Editorial and trade attributes for wine products, organized by tab. Pricing visibility is not set here — prices are hidden from logged-out visitors site-wide (inc/woocommerce.php).",
    "show_in_rest": 1,
    "modified": 1756000000
}
